{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ereader",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Cloudflare D1 — book + user metadata.
  // Create with: wrangler d1 create ereader-db
  // Then paste the returned database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ereader-db",
      "database_id": "417ce42c-18e2-41bc-8cb9-444d00f9d3a7"
    }
  ],




// Cloudflare R2 — actual book files (pdf/epub) + cover images.
  // Create with: wrangler r2 bucket create ereader-files
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "ereader-files"
    }
  ],

  // Cloudflare KV — you already created this namespace ("ereader").
  // Used here for logout / token revocation.
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "7284b235b7b14c239ae3ab6e5480c6c2"
    }
  ],

  // JWT_SECRET and RESEND_API_KEY are intentionally NOT declared here.
  // They must be set as encrypted Secrets in the Cloudflare dashboard
  // (Worker → Settings → Variables and Secrets → Add → Secret) instead.
  // If they're declared in this file's "vars", every deploy overwrites
  // whatever value is set in the dashboard back to whatever's here —
  // which is exactly what kept undoing the real API key.
  "vars": {},

}

